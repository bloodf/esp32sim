{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "esp32sim",
  "version": "0.1.0",
  "identifier": "dev.esp32sim.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "ESP32 emulator, circuit simulator and IDE",
    "longDescription": "Run real ESP32 firmware against a simulated circuit: wire parts in the editor, watch displays and LEDs, debug the code and test it before touching hardware.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
